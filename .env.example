# Copy to .env.local. Every variable here is server-only; never prefix with NEXT_PUBLIC_.

# Where the backend's JSON store writes orders, club enquiries and newsletter sign-ups.
# Defaults to ./.data. On read-only hosts (e.g. Vercel) the store falls back to memory.
ARROW_DATA_DIR=.data

# Frontend-only build (npm run build:frontend, used on Vercel): no API routes are deployed.
# Point the cart, club and newsletter forms at a backend hosted elsewhere, e.g. https://api.example.com.
# Leave empty and those forms show a "not available" message instead of submitting.
NEXT_PUBLIC_API_URL=
